---
// Home page for the Robotability project.
// It renders the personal-site design language with the T2 components.
// The feature pills and the indicator glossary come from JSON files.
// The page maps over the JSON data. It holds no hardcoded lists.
import Layout from '@layouts/Default.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import DashedLink from '@components/ui/DashedLink.astro';
import HoverReveal from '@components/ui/HoverReveal.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import SubHeading from '@components/ui/SubHeading.astro';
import LazyBoxVideo from '@components/custom/LazyBoxVideo.astro';
import features from '../data/features.json';
import indicators from '../data/indicators.json';

// The paper DOI. Keep it exactly as published.
const paperUrl = 'https://dl.acm.org/doi/full/10.1145/3706598.3714009';
// The code repository URL.
const codeUrl = 'https://github.com/FAR-LAB/robotability-nyc';
// The NYC OpenData portal URL.
const nycOpenDataUrl = 'https://opendata.cityofnewyork.us/';

// The exact NYC OpenData Terms of Use disclaimer sentence. Keep it verbatim.
const touDisclaimer =
  'The City of New York can not vouch for the accuracy or completeness of data provided by this web site or application or for the usefulness or integrity of the web site or application. This site provides applications using data that has been modified for use from its original source, NYC.gov, the official web site of the City of New York.';

// The team grid. Keep the images and the copy exactly as before.
const teamMembers = [
  {
    name: 'Matt Franchi',
    role: 'Computer Science PhD Candidate',
    image: '/team/matt.jpg',
    link: 'https://mattwfranchi.github.io',
  },
  {
    name: 'Maria Teresa Parreira',
    role: 'Information Science PhD Candidate',
    image: '/team/teresa.png',
    link: 'https://www.mariateresaparreira.com/',
  },
  {
    name: 'Frank Bu',
    role: 'Computer Science PhD Candidate',
    image: '/team/frank.jpg',
    link: 'https://frankbu0616.github.io/',
  },
  {
    name: 'Wendy Ju',
    role: 'Associate Professor',
    image: '/team/wendy.jpg',
    link: 'https://wendyju.com',
  },
];

// The citation BibTeX block. Keep it verbatim.
const citation = `@inproceedings{10.1145/3706598.3714009,
author = {Franchi, Matthew and Parreira, Maria Teresa and Bu, Fanjun and Ju, Wendy},
title = {The Robotability Score: Enabling Harmonious Robot Navigation on Urban Streets},
year = {2025},
isbn = {9798400713941},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706598.3714009},
doi = {10.1145/3706598.3714009},
booktitle = {Proceedings of the 2025 CHI Conference on Human Factors in Computing Systems},
articleno = {737},
numpages = {17},
  series = {CHI '25}
}`;

// The readable-ink subset of the house palette. Six colors. One per bar.
// The index aligns with features.json order. That order is descending weight.
const FEATURE_INK = [
  '#498573', // teal     - Pedestrian Density
  '#5674b3', // blue     - Crowd Dynamics
  '#e57264', // coral    - Pedestrian Flow
  '#a08a6f', // tan      - Sidewalk Quality
  '#83bd7b', // green    - Street Width
  '#7a6f63', // warmgrey - Density of Street Furniture
];

// The dark edge color. It matches the paper patch.edgecolor.
const FEATURE_EDGE = '#1a1a1a';

// Parse the survey weights. Scale the bars to the largest weight.
// The data file is the only source. Do not hardcode the maximum.
const maxFeatureWeight = Math.max(
  ...features.map((feature) => parseFloat(feature.weight))
);

// Build the chart rows. Each row pairs a feature with its ink color
// and its proportional bar width. The width is a percent of the track.
const featureRows = features.map((feature, index) => ({
  name: feature.name,
  weight: feature.weight,
  widthPercent: (parseFloat(feature.weight) / maxFeatureWeight) * 100,
  color: FEATURE_INK[index],
}));

// The figure label for assistive tech. It names the leader.
// It stays in sync with the data. Do not hardcode the values.
const chartLabel = `Bar chart of the six key features and their survey weights. ${featureRows[0].name} leads at ${featureRows[0].weight.replace('%', ' percent')}.`;
---

<Layout
  title='The Robotability Score, Made @ Cornell Tech'
  pageTitle='The Robotability Score'
  description='A novel metric for quantifying urban robot navigation suitability'
>
  <main class='mx-auto w-full max-w-6xl flex-1 px-6 pb-16'>
    <!-- Section 1: hero. Title, one-paragraph abstract, CTA buttons. -->
    <section id='hero' class='home-section pt-12'>
      <div class='grid items-start gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]'>
        <div>
          <p class='mb-4 text-sm opacity-70'>
            @ CHI '25: ACM Conference on Human Factors in Computing Systems
          </p>
          <h1 class='text-4xl font-bold text-skin-base lg:text-5xl'>
            The Robotability Score
          </h1>
          <p class='mt-2 text-xl text-skin-base opacity-80'>
            Enabling Harmonious Robot Navigation on Urban Streets
          </p>
          <p class='mt-6 max-w-prose text-skin-base'>
            The Robotability Score (R) measures how suitable urban streets are
            for autonomous robot navigation. It combines 24 indicators of the
            built environment into one number, so researchers and planners can
            compare locations and predict where robots can operate without
            disrupting the people around them. We built and validated a
            proof-of-concept score for all of New York City.
          </p>
          <div class='mt-8 flex flex-wrap items-center gap-4'>
            <Button href='/map'>Explore the Map</Button>
            <Button href={paperUrl} external>Read the Paper</Button>
            <DashedLink href={codeUrl} external>Code Repository</DashedLink>
          </div>
        </div>
        <Card class='hidden lg:block'>
          <SubHeading level='h3'>Made at Cornell Tech</SubHeading>
          <p class='text-sm text-skin-base'>
            This project comes from the
            <DashedLink href='https://far.tech.cornell.edu/' external>
              Future Autonomous Robotics (FAR) Lab
            </DashedLink>
            at Cornell Tech, New York City. It was presented at CHI '25.
          </p>
        </Card>
      </div>
    </section>

    <!-- Section 2: explainer. The copy is ported from the previous page. -->
    <section id='what-is-robotability' class='home-section'>
      <SectionHeading id='what-is-robotability-heading'>
        What is The Robotability Score?
      </SectionHeading>
      <div class='max-w-prose space-y-4'>
        <p class='text-skin-base'>
          The Robotability Score (R) is a novel metric that quantifies how suitable
          urban environments are for autonomous robot navigation. Through expert
          interviews and surveys, we've developed a standardized framework for
          evaluating urban landscapes to reduce uncertainty in robot deployment
          while respecting established mobility patterns.
        </p>
        <p class='text-skin-base'>
          Streets with high Robotability are both more navigable for robots and
          less disruptive to pedestrians. We've constructed a proof-of-concept
          Robotability Score for New York City using a wealth of open datasets
          from NYC OpenData, and inferred pedestrian distributions from a dataset
          of 8 million dashcam images taken around the city in late 2023.
        </p>
      </div>
    </section>

    <!-- Section 3: key features. The bar chart renders from features.json. -->
    <section id='key-features' class='home-section'>
      <SectionHeading id='key-features-heading'>Key Features</SectionHeading>
      <figure
        class='feature-chart'
        role='img'
        aria-label={chartLabel}
        style={`--feature-edge: ${FEATURE_EDGE};`}
      >
        {
          featureRows.map((row) => (
            <div data-testid='feature-pill' class='feature-row'>
              <span class='feature-label'>{row.name}</span>
              <div class='feature-track'>
                <div
                  class='feature-bar'
                  style={`width: ${row.widthPercent}%; background-color: ${row.color};`}
                />
              </div>
              <span class='feature-value'>{row.weight}</span>
            </div>
          ))
        }
      </figure>
      <p class='mt-6 max-w-prose text-skin-base'>
        Our findings reveal that these factors collectively account for 48% of
        the total Robotability Score. Areas with highest R are 4.3 times more
        "robotable" than areas with lowest R.
      </p>
    </section>

    <!-- Section 4: indicator glossary. The entries render from indicators.json.
         Each term is a HoverReveal anchor. The satellite card shows the scale. -->
    <section id='indicators' class='home-section'>
      <SectionHeading id='indicators-heading'>
        Complete Indicator List
      </SectionHeading>
      <p class='max-w-prose text-skin-base'>
        The score draws on 24 indicators. Hover over any term to see how we
        measure it. Each indicator is paired with a sample set of weights to
        show how the Robotability Score might change under different indicator
        values.
      </p>
      <ul
        data-testid='indicator-glossary'
        class='mt-6 grid grid-cols-1 gap-x-10 gap-y-3 md:grid-cols-2'
      >
        {
          indicators.map((indicator, index) => (
            <li data-testid='indicator-entry' class='indicator-entry'>
              <HoverReveal
                id={`indicator-${index}`}
                variant='text'
                text={indicator.description}
                label={`${indicator.term} scale`}
                size='md'
                placement='top-right'
                curve='natural'
                distance='short'
              >
                {indicator.term}
              </HoverReveal>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Section 5: video. The LazyBoxVideo id and params stay untouched. -->
    <section id='video' class='home-section'>
      <SectionHeading id='video-heading'>Proof-of-Concept Video</SectionHeading>
      <Card>
        <LazyBoxVideo
          videoId='o52MZ1AHyjA'
          title='Robotability Proof-of-Concept: TrashBot in NYC'
        />
      </Card>
    </section>

    <!-- Section 6: team grid. The images and copy stay exactly as before. -->
    <section id='team' class='home-section'>
      <SectionHeading id='team-heading'>Project Team</SectionHeading>
      <div class='grid grid-cols-2 gap-8 lg:grid-cols-4'>
        {
          teamMembers.map((member) => (
            <a
              href={member.link}
              class='group flex flex-col items-center no-underline'
            >
              <div class='mb-3 h-24 w-24 overflow-hidden rounded-full border border-skin-line lg:h-32 lg:w-32'>
                <img
                  src={member.image}
                  alt={member.name}
                  class='h-full w-full object-cover'
                />
              </div>
              <h3 class='text-center text-lg text-skin-base'>{member.name}</h3>
              <p class='text-center text-sm text-skin-base opacity-70'>
                {member.role}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Section 7: citation. The BibTeX block stays verbatim. -->
    <section id='citation' class='home-section'>
      <SectionHeading id='citation-heading'>Paper Citation</SectionHeading>
      <p class='max-w-prose text-skin-base'>
        If you use our work in your research, please cite our paper:
      </p>
      <Card class='mt-4 overflow-x-auto'>
        <pre class='whitespace-pre-wrap font-mono text-sm'><code>{citation}</code></pre>
      </Card>
      <p class='mt-4'>
        <DashedLink href={paperUrl} external>
          View the paper on the ACM Digital Library
        </DashedLink>
      </p>
    </section>

    <!-- Section 8: data attribution footer.
         It carries the NYC OpenData attribution and the ToU disclaimer. -->
    <footer data-testid='home-footer' class='home-section border-t border-skin-line pt-8'>
      <SectionHeading id='data-attribution-heading' level='h2'>
        Data Attribution
      </SectionHeading>
      <div class='max-w-prose space-y-3 text-sm text-skin-base'>
        <p>
          The Robotability Score for New York City is computed in part from
          public datasets published on
          <DashedLink href={nycOpenDataUrl} external>NYC OpenData</DashedLink>.
          This project is not affiliated with or endorsed by the City of New
          York.
        </p>
        <p>{touDisclaimer}</p>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Space between the home sections. */
  .home-section {
    margin-top: 4rem;
  }

  /* Key features bar chart. The bars carry the paper house palette.
     The figure has no background. It inherits the site ground. */
  .feature-chart {
    margin: 0;
    max-width: 48rem;
    padding: 1.25rem 1rem;
  }

  /* One row. Label on the left. Track in the middle. Value on the right.
     The label column has a fixed width, so every track starts at the
     same x position. */
  .feature-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) max-content;
    align-items: center;
    column-gap: 0.75rem;
  }

  /* Feature label. Real text. It adapts to the theme. */
  .feature-label {
    color: rgb(var(--color-text-base));
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Value label. It adapts to the theme. Tabular figures line up. */
  .feature-value {
    color: rgb(var(--color-text-base));
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The bar track. It holds the gridlines and the bar fill. */
  .feature-track {
    position: relative;
    padding-block: 0.4rem;
    background-image: repeating-linear-gradient(
      to right,
      rgba(var(--color-text-base), 0.2) 0,
      rgba(var(--color-text-base), 0.2) 1px,
      transparent 1px,
      transparent 25%
    );
  }

  /* The 0 baseline. It spans the full track height. It is clearer than gridlines. */
  .feature-track::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(var(--color-text-base), 0.45);
  }

  /* The bar fill. Thin dark edge. Fixed palette color. */
  .feature-bar {
    box-sizing: border-box;
    height: 1.25rem;
    border: 1px solid var(--feature-edge);
  }

  /* Narrow screens. Stack the label above the bar. */
  @media (max-width: 639px) {
    .feature-row {
      grid-template-columns: minmax(0, 1fr) max-content;
      grid-template-rows: auto auto;
      row-gap: 0.25rem;
    }
    .feature-label {
      grid-column: 1 / -1;
    }
  }

  /* Indicator entry. Give the anchor a clear hit area. */
  .indicator-entry {
    padding: 0.25rem 0;
    line-height: 1.6;
  }
</style>
