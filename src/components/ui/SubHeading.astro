---
/**
 * SubHeading — subsection heading.
 * It renders a heading with a left accent bar.
 * The bar matches .subsection-heading::before on the reference site:
 * 3px wide, 1.2em tall, text-base color at 0.5 opacity.
 */
interface Props {
  /** Heading level. Defaults to h3. */
  level?: 'h3' | 'h4';
  /** Optional id attribute. */
  id?: string;
}

const { level = 'h3', id } = Astro.props;
const Tag = level;
---

<Tag id={id} class='subsection-heading text-lg text-skin-base'>
  <slot />
</Tag>

<style>
  .subsection-heading {
    position: relative;
    display: inline-block;
    padding-left: 0.75rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .subsection-heading::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    height: 1.2em;
    width: 3px;
    background-color: rgba(var(--color-text-base), 0.5);
    border-radius: 1px;
  }
</style>
