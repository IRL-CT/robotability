---
/**
 * HoverReveal — marginalia-style hover annotation.
 *
 * Wraps an inline word/phrase. On hover/focus, a tethered card floats
 * nearby (image, logo, or text), connected by a drawn curve. Optionally
 * links to a URL.
 *
 * Slot: the word(s) to annotate.
 */
export interface Props {
  /** Visual variant of the revealed card */
  variant?: "image" | "logo" | "text";
  /** Image source (for image/logo variants) */
  src?: string;
  /** Alt text for image */
  alt?: string;
  /** Text to display (for text variant) */
  text?: string;
  /** Optional link URL — makes the card clickable */
  href?: string;
  /** Open link in new tab */
  external?: boolean;
  /** Accessible label for the card as a whole */
  label?: string;
  /** Card size */
  size?: "sm" | "md" | "lg";
  /** Card shape (images only) */
  shape?: "circle" | "rect" | "portrait";
  /** Placement relative to the word */
  placement?: "top-right" | "top-left" | "bottom-right" | "bottom-left";
  /** Tether curve shape */
  curve?: "natural" | "arc-right" | "arc-left" | "taut" | "loop";
  /** Tether length — how far the card floats from the word */
  distance?: "short" | "normal" | "long" | "xlong";
  /** Unique identifier (useful for future JS / analytics) */
  id?: string;
}

const {
  variant = "image",
  src,
  alt = "",
  text,
  href,
  external = false,
  label,
  size = "sm",
  shape = "circle",
  placement = "top-right",
  curve = "natural",
  distance = "normal",
  id,
} = Astro.props;

// Tether path — drawn in a 100x100 viewBox and stretched to the tether's
// bounding area. SVG has overflow: visible so curves can swoop outside the box.
// pathLength="100" normalizes for stroke-dasharray draw-in regardless of shape.
const tetherPaths: Record<string, Record<string, string>> = {
  natural: {
    "top-right": "M 2 98 Q 18 44, 98 2",
    "top-left": "M 98 98 Q 82 44, 2 2",
    "bottom-right": "M 2 2 Q 18 56, 98 98",
    "bottom-left": "M 98 2 Q 82 56, 2 98",
  },
  "arc-right": {
    "top-right": "M 2 98 C 78 92, 122 42, 98 2",
    "top-left": "M 98 98 C 100 60, 122 22, 2 2",
    "bottom-right": "M 2 2 C 78 8, 122 58, 98 98",
    "bottom-left": "M 98 2 C 100 40, 122 78, 2 98",
  },
  "arc-left": {
    "top-right": "M 2 98 C 6 58, -22 22, 98 2",
    "top-left": "M 98 98 C 22 92, -22 42, 2 2",
    "bottom-right": "M 2 2 C 6 42, -22 78, 98 98",
    "bottom-left": "M 98 2 C 22 8, -22 58, 2 98",
  },
  taut: {
    "top-right": "M 2 98 Q 56 56, 98 2",
    "top-left": "M 98 98 Q 44 56, 2 2",
    "bottom-right": "M 2 2 Q 56 44, 98 98",
    "bottom-left": "M 98 2 Q 44 44, 2 98",
  },
  loop: {
    "top-right": "M 2 98 C 96 104, 124 72, 54 48 C 14 34, 92 18, 98 2",
    "top-left": "M 98 98 C 4 104, -24 72, 46 48 C 86 34, 8 18, 2 2",
    "bottom-right": "M 2 2 C 96 -4, 124 28, 54 52 C 14 66, 92 82, 98 98",
    "bottom-left": "M 98 2 C 4 -4, -24 28, 46 52 C 86 66, 8 82, 2 98",
  },
};

const tetherPath = tetherPaths[curve][placement];

// Size → base tether + card dimensions
const sizeTokens = {
  sm: { size: 88,  dx: 70, dy: 78  },
  md: { size: 116, dx: 84, dy: 96  },
  lg: { size: 148, dx: 96, dy: 120 },
};
const distTokens = { short: 0.7, normal: 1, long: 1.6, xlong: 2.2 };

const s = sizeTokens[size];
const d = distTokens[distance];

const inlineStyle = [
  `--reveal-size: ${s.size}px`,
  `--reveal-dx-base: ${s.dx}px`,
  `--reveal-dy-base: ${s.dy}px`,
  `--reveal-dist: ${d}`,
].join("; ");

// Wrapper for card contents — link if href provided, else span (keeps inline flow).
const CardTag = href ? "a" : "span";
const linkProps = href
  ? {
      href,
      ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}),
    }
  : {};
---

<span class:list={["hover-reveal", `hover-reveal--${placement}`, `hover-reveal--${shape}`]} style={inlineStyle} data-hover-reveal={id} data-placement={placement}
><span class="hover-reveal__word" tabindex="0" aria-describedby={id ? `${id}-card` : undefined}><slot /></span><svg class="hover-reveal__tether" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={tetherPath} vector-effect="non-scaling-stroke" pathLength="100" /></svg><CardTag class:list={["hover-reveal__card", `hover-reveal__card--${variant}`]} id={id ? `${id}-card` : undefined} role={href ? undefined : "img"} aria-label={label} {...linkProps}>{variant === "image" && src && <img src={src} alt={alt} loading="lazy" draggable="false" />}{variant === "logo" && src && <img src={src} alt={alt} loading="lazy" draggable="false" class="is-logo" />}{variant === "text" && text && <span class="hover-reveal__text">{text}</span>}</CardTag></span>

<script>
  // The touch script reads resolve() through a window hook. The
  // augmentation gives the hook a real type, so neither use site needs
  // a cast. The export marks this script as a module, which the global
  // augmentation requires.
  export {};

  declare global {
    interface Window {
      __resolveReveal?: (wrapper: HTMLElement) => void;
    }
  }

  // —————————————————————————————————————————————————————————————————
  // 1. Viewport-aware placement (all devices, runs on load + resize)
  //
  //    For each satellite, compute which placement + distance keeps
  //    the card fully on-screen. Tries all 4 placements at multiple
  //    distances, clamping as a last resort. The tether path is
  //    computed dynamically from word-anchor → card-anchor so it
  //    curves naturally for any geometry.
  // —————————————————————————————————————————————————————————————————
  (() => {
    if (typeof window === "undefined") return;

    const PLACEMENTS = ["top-right", "top-left", "bottom-right", "bottom-left"] as const;
    type Placement = (typeof PLACEMENTS)[number];
    const DIST_STEPS = [1, 0.6, 0.3, 0.1];
    const EDGE_PAD = 8; // px from viewport side/bottom edges
    const HEADER_GAP = 10; // breathing room below the fixed header

    // Coarse-pointer (touch) devices always use the deterministic,
    // viewport-anchored path — never the wrapper-relative happy path,
    // since inline anchors wrap unpredictably in the narrow column.
    const isCoarse =
      window.matchMedia("(hover: none) and (pointer: coarse)").matches;

    /**
     * Safe region the card must stay inside, in viewport coordinates.
     * The top inset tracks the *live* header box (it shrinks on scroll
     * and changes height responsively), so a card can never be drawn
     * behind the fixed header. Falls back to the --header-height CSS
     * custom property, then to a bare edge pad.
     */
    function safeInsets() {
      let top = EDGE_PAD;
      const header = document.querySelector<HTMLElement>("#main-header");
      if (header) {
        const hb = header.getBoundingClientRect().bottom;
        if (hb > 0) top = hb + HEADER_GAP;
      } else {
        const cssH = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue("--header-height"),
        );
        if (cssH > 0) top = cssH + HEADER_GAP;
      }
      return {
        top,
        left: EDGE_PAD,
        right: window.innerWidth - EDGE_PAD,
        bottom: window.innerHeight - EDGE_PAD,
      };
    }

    const wrappers = document.querySelectorAll<HTMLElement>(".hover-reveal");
    if (!wrappers.length) return;

    /** Card's viewport rect for a given placement + distance scale. */
    function cardRect(
      wordRect: DOMRect, placement: Placement,
      dx: number, dy: number, cardW: number, cardH: number,
    ) {
      switch (placement) {
        case "top-right":
          return { l: wordRect.right,            t: wordRect.top - dy - cardH,    r: wordRect.right + dx + cardW,  b: wordRect.top - dy };
        case "top-left":
          return { l: wordRect.left - dx - cardW, t: wordRect.top - dy - cardH,   r: wordRect.left,                b: wordRect.top - dy };
        case "bottom-right":
          return { l: wordRect.right,             t: wordRect.bottom + dy,         r: wordRect.right + dx + cardW,  b: wordRect.bottom + dy + cardH };
        case "bottom-left":
          return { l: wordRect.left - dx - cardW, t: wordRect.bottom + dy,         r: wordRect.left,                b: wordRect.bottom + dy + cardH };
      }
    }

    type Insets = ReturnType<typeof safeInsets>;

    function rectOverflow(
      rect: { l: number; t: number; r: number; b: number }, ins: Insets,
    ) {
      return (
        Math.max(0, ins.left - rect.l) +
        Math.max(0, rect.r - ins.right) +
        Math.max(0, ins.top - rect.t) +
        Math.max(0, rect.b - ins.bottom)
      );
    }

    /** Clamp a rect into the safe region, returning the shift applied. */
    function clampRect(
      rect: { l: number; t: number; r: number; b: number }, ins: Insets,
    ) {
      let shiftX = 0, shiftY = 0;
      if (rect.l < ins.left) shiftX = ins.left - rect.l;
      else if (rect.r > ins.right) shiftX = ins.right - rect.r;
      if (rect.t < ins.top) shiftY = ins.top - rect.t;
      else if (rect.b > ins.bottom) shiftY = ins.bottom - rect.b;
      return {
        rect: { l: rect.l + shiftX, t: rect.t + shiftY, r: rect.r + shiftX, b: rect.b + shiftY },
        shiftX, shiftY,
      };
    }

    /** Generate a quadratic bezier tether path between two anchor
     *  points, expressed in a 100×100 viewBox. The control point
     *  is offset perpendicular to the line for a natural curve. */
    function tetherPath(
      x0: number, y0: number, x1: number, y1: number,
    ) {
      // Midpoint
      const mx = (x0 + x1) / 2;
      const my = (y0 + y1) / 2;
      // Perpendicular offset (gives the curve its bow)
      const len = Math.hypot(x1 - x0, y1 - y0) || 1;
      const nx = -(y1 - y0) / len;
      const ny =  (x1 - x0) / len;
      const bow = 18; // how far the curve bulges, in viewBox units
      const cx = mx + nx * bow;
      const cy = my + ny * bow;
      return `M ${x0.toFixed(1)} ${y0.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)}, ${x1.toFixed(1)} ${y1.toFixed(1)}`;
    }

    /** Word-side anchor (0..100) and card-side anchor (0..100) in the
     *  tether's coordinate space, given the placement direction. */
    function tetherAnchors(placement: Placement) {
      switch (placement) {
        case "top-right":    return { wx: 2, wy: 98, cx: 98, cy: 2 };
        case "top-left":     return { wx: 98, wy: 98, cx: 2, cy: 2 };
        case "bottom-right": return { wx: 2, wy: 2,  cx: 98, cy: 98 };
        case "bottom-left":  return { wx: 98, wy: 2,  cx: 2,  cy: 98 };
      }
    }

    function applyPlacement(wrapper: HTMLElement, placement: Placement) {
      PLACEMENTS.forEach((p) => wrapper.classList.remove(`hover-reveal--${p}`));
      wrapper.classList.add(`hover-reveal--${placement}`);
    }

    function resolve(wrapper: HTMLElement) {
      const vw = window.innerWidth;
      {
        const word = wrapper.querySelector<HTMLElement>(".hover-reveal__word");
        const card = wrapper.querySelector<HTMLElement>(".hover-reveal__card");
        const tether = wrapper.querySelector<SVGSVGElement>(".hover-reveal__tether");
        const pathEl = tether?.querySelector<SVGPathElement>("path");
        if (!word || !card || !tether || !pathEl) return;

        // An inline anchor that wraps across lines has several client
        // rects; getBoundingClientRect() would return their full-width
        // union and throw off every placement. Anchor to the dominant
        // (widest) line fragment instead.
        const wordRects = Array.from(word.getClientRects());
        const wordRect = wordRects.length
          ? wordRects.reduce((a, b) => (b.width >= a.width ? b : a))
          : word.getBoundingClientRect();
        const ins = safeInsets();
        const cs = getComputedStyle(wrapper);
        const size = parseFloat(cs.getPropertyValue("--reveal-size")) || 88;
        const dxBase = parseFloat(cs.getPropertyValue("--reveal-dx-base")) || 70;
        const dyBase = parseFloat(cs.getPropertyValue("--reveal-dy-base")) || 78;
        const authoredDist = parseFloat(cs.getPropertyValue("--reveal-dist")) || 1;

        let cardW = size, cardH = size;
        if (wrapper.classList.contains("hover-reveal--rect")) {
          cardW = size * 1.5; cardH = size;
        } else if (wrapper.classList.contains("hover-reveal--portrait")) {
          cardW = size * 0.72; cardH = size * 1.1;
        }

        const authored = (wrapper.dataset.placement || "top-right") as Placement;
        const wordCx = (wordRect.left + wordRect.right) / 2;

        // Build candidates: 4 placements × distance steps + centered above/below.
        type Candidate = {
          p: Placement;
          rect: { l: number; t: number; r: number; b: number };
          shiftNeeded: number;
        };

        const candidates: Candidate[] = [];

        for (const dMult of DIST_STEPS) {
          const dx = dxBase * authoredDist * dMult;
          const dy = dyBase * authoredDist * dMult;
          for (const p of PLACEMENTS) {
            const r = cardRect(wordRect, p, dx, dy, cardW, cardH);
            const { shiftX, shiftY } = clampRect(r, ins);
            candidates.push({
              p,
              rect: { l: r.l + shiftX, t: r.t + shiftY, r: r.r + shiftX, b: r.b + shiftY },
              shiftNeeded: Math.abs(shiftX) + Math.abs(shiftY),
            });
          }
        }

        // Add centered-below and centered-above candidates.
        for (const vert of ["above", "below"] as const) {
          const dy = dyBase * authoredDist * 0.3;
          const cl = wordCx - cardW / 2;
          const ct = vert === "below" ? wordRect.bottom + dy : wordRect.top - dy - cardH;
          const r = { l: cl, t: ct, r: cl + cardW, b: ct + cardH };
          const { shiftX, shiftY } = clampRect(r, ins);
          // Map to the nearest quadrant placement for CSS class.
          const quadrant: Placement = vert === "below"
            ? (wordCx > vw / 2 ? "bottom-left" : "bottom-right")
            : (wordCx > vw / 2 ? "top-left" : "top-right");
          candidates.push({
            p: quadrant,
            rect: { l: r.l + shiftX, t: r.t + shiftY, r: r.r + shiftX, b: r.b + shiftY },
            shiftNeeded: Math.abs(shiftX) + Math.abs(shiftY),
          });
        }

        // Sort: prefer authored placement, then least shift, then largest card-to-word distance.
        candidates.sort((a, b) => {
          // Zero-shift candidates first.
          const aZero = a.shiftNeeded < 1 ? 0 : 1;
          const bZero = b.shiftNeeded < 1 ? 0 : 1;
          if (aZero !== bZero) return aZero - bZero;
          // Among equal-shift, prefer authored placement.
          const aAuth = a.p === authored ? 0 : 1;
          const bAuth = b.p === authored ? 0 : 1;
          if (aAuth !== bAuth) return aAuth - bAuth;
          // Less shift wins.
          return a.shiftNeeded - b.shiftNeeded;
        });

        const best = candidates[0];
        if (!best) return;

        // Determine if the unclamped authored placement fits at full distance.
        const fullDx = dxBase * authoredDist;
        const fullDy = dyBase * authoredDist;
        const authoredRect = cardRect(wordRect, authored, fullDx, fullDy, cardW, cardH);
        const authoredFits = rectOverflow(authoredRect, ins) < 1;

        if (authoredFits && !isCoarse) {
          // Happy path: authored placement fits. Use CSS classes directly,
          // restore original vars, clear any inline overrides.
          applyPlacement(wrapper, authored);
          wrapper.style.removeProperty("--reveal-dx");
          wrapper.style.removeProperty("--reveal-dy");
          card.style.removeProperty("--clamp-x");
          card.style.removeProperty("--clamp-y");
          card.style.removeProperty("left");
          card.style.removeProperty("top");
          card.style.removeProperty("bottom");
          card.style.removeProperty("right");
          card.classList.remove("is-clamped");
          wrapper.classList.remove("is-clamped");
          tether.style.removeProperty("width");
          tether.style.removeProperty("height");
          tether.style.removeProperty("left");
          tether.style.removeProperty("right");
          tether.style.removeProperty("top");
          tether.style.removeProperty("bottom");
          const a = tetherAnchors(authored);
          pathEl.setAttribute("d", tetherPath(a.wx, a.wy, a.cx, a.cy));
          return;
        }

        // Constrained path: card is repositioned to a guaranteed-safe
        // slot. Card + tether switch to position:fixed (via .is-clamped)
        // and are placed in *viewport* coordinates — independent of the
        // inline wrapper's box, which is unreliable when the anchor word
        // wraps. best.rect is already clamped inside safeInsets(), so the
        // card can never land behind the header or off any edge.
        card.classList.add("is-clamped");
        wrapper.classList.add("is-clamped");
        card.style.left = best.rect.l + "px";
        card.style.top = best.rect.t + "px";
        card.style.bottom = "auto";
        card.style.right = "auto";

        const cardLeft = best.rect.l;
        const cardTop = best.rect.t;
        const cCx = cardLeft + cardW / 2;
        const cCy = cardTop + cardH / 2;

        // Word anchor: the point on the word fragment nearest the card.
        // Re-pick the closest line fragment so a wrapped word's tether
        // attaches to the fragment the reader is actually looking at.
        const near = (r: DOMRect) =>
          Math.hypot((r.left + r.right) / 2 - cCx, (r.top + r.bottom) / 2 - cCy);
        const wf = wordRects.length
          ? wordRects.reduce((a, b) => (near(b) < near(a) ? b : a))
          : wordRect;
        const wAnchorX = Math.max(wf.left, Math.min(wf.right, cCx));
        const wAnchorY = Math.max(wf.top, Math.min(wf.bottom, cCy));

        // Card anchor point (nearest edge center to word).
        let cAnchorX: number, cAnchorY: number;
        if (Math.abs(cCx - wAnchorX) > Math.abs(cCy - wAnchorY)) {
          // Horizontal gap dominates → anchor on left or right edge of card.
          cAnchorX = cCx < wAnchorX ? cardLeft + cardW : cardLeft;
          cAnchorY = Math.max(cardTop, Math.min(cardTop + cardH, wAnchorY));
        } else {
          // Vertical gap dominates → anchor on top or bottom edge.
          cAnchorX = Math.max(cardLeft, Math.min(cardLeft + cardW, wAnchorX));
          cAnchorY = cCy < wAnchorY ? cardTop + cardH : cardTop;
        }

        // Tether SVG: fixed, spanning word anchor → card anchor (viewport).
        const tetherLeft = Math.min(wAnchorX, cAnchorX);
        const tetherTop = Math.min(wAnchorY, cAnchorY);
        const tetherW = Math.max(12, Math.abs(cAnchorX - wAnchorX));
        const tetherH = Math.max(12, Math.abs(cAnchorY - wAnchorY));

        tether.style.left = tetherLeft + "px";
        tether.style.top = tetherTop + "px";
        tether.style.width = tetherW + "px";
        tether.style.height = tetherH + "px";
        tether.style.bottom = "auto";
        tether.style.right = "auto";

        // Path: map word/card anchors into the 100×100 viewBox.
        const wx = ((wAnchorX - tetherLeft) / tetherW) * 100;
        const wy = ((wAnchorY - tetherTop) / tetherH) * 100;
        const cx = ((cAnchorX - tetherLeft) / tetherW) * 100;
        const cy = ((cAnchorY - tetherTop) / tetherH) * 100;
        pathEl.setAttribute("d", tetherPath(wx, wy, cx, cy));

        // Set a dummy placement class (for bridge/open-state CSS).
        applyPlacement(wrapper, best.p);
        wrapper.style.setProperty("--reveal-dx", tetherW + "px");
        wrapper.style.setProperty("--reveal-dy", tetherH + "px");
      }
    }

    // Expose resolve() globally so the touch script can call it too.
    window.__resolveReveal = resolve;

    // On desktop, resolve placement just before the card appears (mouseenter).
    wrappers.forEach((wrapper) => {
      wrapper.addEventListener("mouseenter", () => resolve(wrapper));
    });

    // On resize, viewport dimensions change — re-resolve all.
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => wrappers.forEach(resolve), 150);
    });
  })();

  // —————————————————————————————————————————————————————————————————
  // 2. Touch handling (coarse pointer devices only)
  //
  //    Tapping a word toggles .is-tapped; auto-closes after 3 s.
  //    Tapping outside dismisses. Scroll gestures are ignored.
  // —————————————————————————————————————————————————————————————————
  (() => {
    if (typeof window === "undefined") return;
    const mq = window.matchMedia("(hover: none) and (pointer: coarse)");
    if (!mq.matches) return;

    const wrappers = document.querySelectorAll<HTMLElement>(".hover-reveal");
    if (!wrappers.length) return;

    let autoCloseTimer: ReturnType<typeof setTimeout> | null = null;
    let openWrapper: HTMLElement | null = null;

    const clearTimer = () => {
      if (autoCloseTimer) { clearTimeout(autoCloseTimer); autoCloseTimer = null; }
    };

    const closeAll = () => {
      clearTimer();
      openWrapper = null;
      wrappers.forEach((w) => w.classList.remove("is-tapped"));
    };

    const openSatellite = (wrapper: HTMLElement) => {
      clearTimer();
      if (openWrapper && openWrapper !== wrapper) {
        openWrapper.classList.remove("is-tapped");
      }
      // Resolve placement at the moment of opening, based on current scroll.
      const resolveFn = window.__resolveReveal;
      if (resolveFn) resolveFn(wrapper);
      openWrapper = wrapper;
      scrollAnchorY = window.scrollY;
      wrapper.classList.add("is-tapped");
      autoCloseTimer = setTimeout(() => {
        wrapper.classList.remove("is-tapped");
        if (openWrapper === wrapper) openWrapper = null;
        autoCloseTimer = null;
      }, 3000);
    };

    // A clamped card is position:fixed, resolved against the header/scroll
    // at open time. If the page scrolls while it's open it would detach
    // from its word — so dismiss on scroll instead of letting it drift.
    let scrollAnchorY = window.scrollY;
    window.addEventListener("scroll", () => {
      if (!openWrapper) { scrollAnchorY = window.scrollY; return; }
      if (Math.abs(window.scrollY - scrollAnchorY) > 4) closeAll();
    }, { passive: true });

    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTarget: EventTarget | null = null;
    const MOVE_THRESHOLD = 10;

    document.addEventListener("touchstart", (event) => {
      const t = event.touches[0];
      if (!t) return;
      touchStartX = t.clientX;
      touchStartY = t.clientY;
      touchStartTarget = event.target;
    }, { passive: true });

    document.addEventListener("touchend", (event) => {
      const t = event.changedTouches[0];
      if (!t) return;
      if (Math.abs(t.clientX - touchStartX) > MOVE_THRESHOLD || Math.abs(t.clientY - touchStartY) > MOVE_THRESHOLD) return;

      const target = touchStartTarget as HTMLElement | null;
      if (!target) return;

      const tappedWord = target.closest?.(".hover-reveal__word") as HTMLElement | null;
      const tappedCard = target.closest?.(".hover-reveal__card") as HTMLElement | null;
      const tappedWrapper = target.closest?.(".hover-reveal") as HTMLElement | null;

      if (tappedWord && tappedWrapper) {
        event.preventDefault();
        const wasOpen = tappedWrapper.classList.contains("is-tapped");
        if (wasOpen) { closeAll(); } else { openSatellite(tappedWrapper); }
        return;
      }
      if (tappedCard) return;
      closeAll();
    }, { passive: false });
  })();
</script>
